# ── Majburiy ────────────────────────────────────────────────
# @BotFather bergan token
BOT_TOKEN=
# MCP endpoint himoyasi (uzun tasodifiy qiymat):  openssl rand -hex 32
MCP_AUTH_TOKEN=

# ── Tavsiya etiladi ─────────────────────────────────────────
# Telegram webhook so'rovlarini tekshirish uchun (A-Z a-z 0-9 _ -)
WEBHOOK_SECRET=
# Faqat shu chatlarga yuborishga ruxsat (vergul bilan: -1001234567890,@kanalim,123456)
ALLOWED_CHAT_IDS=

# ── Ixtiyoriy ───────────────────────────────────────────────
# true bo'lsa faqat o'qish toollari ishlaydi (yuborish/o'zgartirish bloklanadi)
READ_ONLY=false
# O'chirib qo'yiladigan toollar: telegram_ban_chat_member,telegram_leave_chat
DISABLED_TOOLS=
# Kiruvchi xabarlarni AI o'qishi uchun (Upstash Redis / Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Webhook update'larini boshqa servisga ham yo'naltirish
WEBHOOK_FORWARD_URL=
# Faqat lokal sinov uchun! Productionda ishlatmang
ALLOW_NO_AUTH=false
